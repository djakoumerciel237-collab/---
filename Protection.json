// ====== LOGGER ======
export class ProtectionLogger {
    static log(protection, action, user, group, details = {}) {
        const timestamp = new Date().toLocaleString("fr-FR");
        console.log(chalk.blue(`[${timestamp}] [${protection.padEnd(15)}] ${action}`));
        if(user) console.log(chalk.gray(` → User: ${user} | Group: ${group}`));
        if(Object.keys(details).length > 0) {
            console.log(chalk.gray(` Details: ${JSON.stringify(details, null, 2)}`));
        }
    }

    static error(protection, error, context = {}) {
        const timestamp = new Date().toLocaleString("fr-FR");
        console.error(chalk.red(`[${timestamp}] [${protection.padEnd(15)}] ERREUR:`, error.message || error));
        if(Object.keys(context).length > 0) {
            console.error(chalk.red(` Contexte: ${JSON.stringify(context)}`));
        }
    }

    static warn(protection, message, context = {}) {
        const timestamp = new Date().toLocaleString("fr-FR");
        console.warn(chalk.yellow(`[${timestamp}] [${protection.padEnd(15)}] AVERTISSEMENT: ${message}`));
        if(Object.keys(context).length > 0) {
            console.warn(chalk.yellow(` → ${JSON.stringify(context)}`));
        }
    }
}

// ====== GESTIONNAIRE D'ÉTAT ======
export class ProtectionManager {
    constructor(ownerID) {
        this.ownerID = ownerID;
        this.userCooldowns = new Map();
        this.spamTracker = new Map();
        this.whitelist = {
            users: new Set([ownerID]),
            groups: new Set(),
            links: new Set(['facebook.com', 'm.facebook.com'])
        };
    }

    isWhitelisted(identifier, type = 'user') {
        if(type === 'user') return this.whitelist.users.has(identifier);
        if(type === 'group') return this.whitelist.groups.has(identifier);
        return false;
    }

    getMessageContent(event) {
        return event.body || "";
    }
}

// ====== UTILITAIRES ======
export async function isBotAdmin(api, threadID) {
    try {
        const info = await api.getThreadInfo(threadID);
        const botID = api.getCurrentUserID();
        return info.adminIDs.some(admin => admin.id == botID);
    } catch(error) {
        ProtectionLogger.error('BOT_ADMIN_CHECK', error, { threadID });
        return false;
    }
}

export async function shouldSkipProtection(api, event, protectionManager) {
    const senderID = event.senderID;
    const threadID = event.threadID;

    if(protectionManager.isWhitelisted(senderID, 'user')) return true;
    if(senderID == api.getCurrentUserID()) return true;

    try {
        const info = await api.getThreadInfo(threadID);
        const isAdmin = info.adminIDs.some(admin => admin.id == senderID);
        return isAdmin;
    } catch {
        return false;
    }
}

// ====== ANTI-LINK ======
export async function antiLink(api, event, protectionManager, config) {
    if(!config.antiLink) return;
    if(await shouldSkipProtection(api, event, protectionManager)) return;

    const text = protectionManager.getMessageContent(event).toLowerCase();
    const hasBlockedLink = CONFIG.blockedLinks.some(link => text.includes(link));

    if(hasBlockedLink) {
        try {
            await api.unsendMessage(event.messageID);
            await api.sendMessage({
                body: `🔗 ${config.messages.antiLink}\n\nUtilisateur: ${event.senderID}`
            }, event.threadID);

            api.setMessageReaction(REACTIONS.antiLink, event.messageID, () => {}, true);
            ProtectionLogger.log('ANTI-LINK', 'Lien bloqué supprimé', event.senderID, event.threadID);
        } catch(error) {
            ProtectionLogger.error('ANTI-LINK', error);
        }
    }
}

// ====== ANTI-SPAM ======
export async function antiSpam(api, event, protectionManager, config) {
    const sender = event.senderID;
    const thread = event.threadID;
    const key = `${thread}:${sender}`;
    const now = Date.now();

    if(!protectionManager.spamTracker.has(key)) {
        protectionManager.spamTracker.set(key, []);
    }

    const history = protectionManager.spamTracker.get(key);
    history.push(now);

    const recent = history.filter(t => now - t < CONFIG.spam.timeWindow);

    if(recent.length > CONFIG.spam.limit) {
        try {
            const isAdmin = await isBotAdmin(api, thread);
            if(isAdmin) {
                await api.removeUserFromGroup(sender, thread);
                await api.sendMessage(`🚫 Spam détecté! ${sender} kické`, thread);
            } else {
                await api.sendMessage(`🚫 Spam détecté (${sender}), mais bot pas admin`, thread);
            }
            protectionManager.spamTracker.delete(key);
            ProtectionLogger.log('ANTI-SPAM', 'Utilisateur kické pour spam', sender, thread);
        } catch(error) {
            ProtectionLogger.error('ANTI-SPAM', error);
        }
    } else {
        protectionManager.spamTracker.set(key, recent);
    }
}

// ====== AUTO-REACT ======
export async function autoReact(api, event, config) {
    if(!config.autoReact) return;
    if(!config.adminBot.includes(event.senderID)) return;

    const randomReact = RANDOM_REACTIONS[Math.floor(Math.random() * RANDOM_REACTIONS.length)];
    api.setMessageReaction(randomReact, event.messageID, () => {}, true);
}

// ====== ANTI-PROMOTE ======
export async function antiPromote(api, event, protectionManager) {
    if(event.logMessageType!== "log:thread-admins") return;
    if(event.logMessageData.addedParticipants.length === 0) return;

    const threadID = event.threadID;
    const addedAdmin = event.logMessageData.addedParticipants[0].userFbId;
    const promoter = event.author;

    if(protectionManager.isWhitelisted(addedAdmin, 'user')) return;
    if(await shouldSkipProtection(api, event, protectionManager)) return;

    try {
        const isAdmin = await isBotAdmin(api, threadID);
        if(!isAdmin) return;

        await api.changeAdminStatus(threadID, addedAdmin, false);

        const msg = `🔥 *ANTI-PROMOTE ACTIVÉ* 🔥\n\n` +
                   `👤 Tentative: ${addedAdmin}\n` +
                   `⚡ Par: ${promoter}\n` +
                   `❌ Action bloquée!\n` +
                   `📍 Groupe: ${threadID}`;

        await api.sendMessage(msg, threadID);
        ProtectionLogger.log('ANTI-PROMOTE', 'Promotion bloquée', addedAdmin, threadID);
    } catch(error) {
        ProtectionLogger.error('ANTI-PROMOTE', error);
    }
}
